# EdgePad: let the logged-in user read the DualSense / DualSense Edge and create a virtual controller.
# Install: sudo cp 70-edgepad.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger

# DualSense (054c:0ce6) and DualSense Edge (054c:0df2), USB
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", MODE="0660", TAG+="uaccess"

# Same controllers over Bluetooth
KERNEL=="hidraw*", KERNELS=="*054C:0CE6*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0DF2*", MODE="0660", TAG+="uaccess"

# Virtual controller output
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", TAG+="uaccess", OPTIONS+="static_node=uinput"
